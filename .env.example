# Kopieer dit bestand naar .env en vul je DEGIRO inloggegevens in:
#   cp .env.example .env
#
# .env wordt NOOIT gecommit (staat in .gitignore).
# Je inloggegevens worden alleen lokaal opgeslagen.

DEGIRO_USERNAME=jouw@email.nl
DEGIRO_PASSWORD=jouwwachtwoord

# Alleen invullen als je 2FA (twee-factor authenticatie) hebt ingeschakeld.
# Dit is de GEHEIME SLEUTEL van je authenticator app (niet de 6-cijferige code).
# Te vinden bij het instellen van 2FA in DEGIRO → Instellingen → Beveiliging.
# DEGIRO_TOTP_SECRET=JOUWSECRETSLEUTEL
